# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env lên git.
# e2e.config.yaml đọc các biến dưới qua ${VAR} — sửa .env khi đổi môi trường, không sửa yaml.

# ---------- Requirement / Jira ----------
JIRA_PROJECT_KEY=OPOS

# Repo app (đường dẫn tương đối từ optis-e2e/) để /e2e analyze đọc git diff — điền nếu 3 repo
# nằm cùng cấp thư mục với optis-e2e/. Để trống nếu không cần đọc diff.
DIFF_REPOS=../PO/api, ../PO/cms, ../PO/tae
BASE_BRANCH=master

# ---------- Store & app (đã xác nhận thật ở khanh-huyen-store, đổi lại nếu dùng store khác) ----------
STORE=khanh-huyen-store
APP_HANDLE=product-options-by-bss

# Host domain thật của app — LẤY TỪ chính giá trị CMS_URL/SERVER_URL trong PO/api/.env hoặc
# PO/cms/.env đang chạy (dev-<tên nhánh dev>-product-option-cms.dev-bsscommerce.com). Đây LÀ
# src iframe app-iframe — bạn cần điền đúng theo dev instance đang test, không có 1 giá trị cố định
# chung cho mọi dev (mỗi dev có nhánh riêng dạng dev-<tên>-product-option-cms...).
APP_DOMAIN=dev-khanh-huyen-product-option-cms.dev-bsscommerce.com

# Domain backend API thật — LẤY TỪ SERVER_URL trong PO/api/.env đang chạy.
API_BASE_URL=https://dev-khanh-huyen-product-option-api.dev-bsscommerce.com

# ---------- Secret ký session-JWT gọi API trực tiếp ----------
# Thứ tự resolve: process.env → optis-e2e/.env → API_ENV_FILE.
# Cách A (khuyên dùng nếu 3 repo nằm cùng máy) — trỏ thẳng tới .env thật của PO/api, khỏi copy lại secret:
API_ENV_FILE=../setup_dev_PO/setup-dev/api/.env
# Cách B — tự chứa, điền trực tiếp (lấy đúng 2 biến này từ PO/api/.env, TÊN BIẾN THẬT không có hậu tố _KEY):
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=

# ---------- Browser khi chạy test ----------
# 1 = ẩn (headless); bỏ trống/0 = mở cửa sổ Chrome thật (khuyên dùng khi mới verify lần đầu).
E2E_HEADLESS=0
